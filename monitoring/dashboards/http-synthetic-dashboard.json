{
  "uid": "robotshop-http-synthetic",
  "title": "Robot Shop - HTTP Availability and Latency",
  "description": "Synthetic HTTP probes, not total application traffic.",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "robot-shop",
    "synthetic-monitoring",
    "capstone-2"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Synthetic HTTP Success (1=Healthy)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"robot-shop-blackbox\",service=~\"web|catalogue|cart|payment\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Synthetic Checks per Minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count_over_time(probe_success{job=\"robot-shop-blackbox\",service=~\"web|catalogue|cart|payment\"}[5m]) / 5",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed Synthetic Checks (%) - 5m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - avg_over_time(probe_success{job=\"robot-shop-blackbox\",service=~\"web|catalogue|cart|payment\"}[5m])) * 100",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Response Status Code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{job=\"robot-shop-blackbox\",service=~\"web|catalogue|cart|payment\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Average HTTP Probe Latency - 5m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(probe_duration_seconds{job=\"robot-shop-blackbox\",service=~\"web|catalogue|cart|payment\"}[5m])",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Maximum HTTP Probe Latency - 5m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(probe_duration_seconds{job=\"robot-shop-blackbox\",service=~\"web|catalogue|cart|payment\"}[5m])",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
